SECRET_KEY=your-django-secret-key
DEBUG=True
USE_SQLITE=True
SQLITE_PATH=C:\path\to\db.sqlite3
DATABASE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1,room-dekho.onrender.com
CORS_ALLOWED_ORIGINS=https://room-dekho.onrender.com

# TEMPORARY: One-time migration endpoint for Vercel
# Generate a strong random token (e.g., openssl rand -hex 32)
# DELETE this after running initial migrations
MIGRATION_SECRET=your-secret-migration-token-here

# PostgreSQL connection
DB_NAME=postgres
DB_USER=your-db-user
DB_PASSWORD=your-database-password
DB_HOST=your-db-host
DB_PORT=5432

EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-app-password
