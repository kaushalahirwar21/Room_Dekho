{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "PYTHON_VERSION": "3.12",
    "DEBUG": "False",
    "ALLOWED_HOSTS": "localhost,127.0.0.1,room-dekho-pied.vercel.app",
    "CORS_ALLOWED_ORIGINS": "https://room-dekho-pied.vercel.app"
  }
}
